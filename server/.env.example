PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hirehub
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Cloudinary (resume/file storage) — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Real AI provider (optional). If ANTHROPIC_API_KEY is empty, the app
# automatically falls back to the built-in rule-based matcher — nothing breaks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Redis (job list caching). If REDIS_URL is empty, caching is skipped safely.
REDIS_URL=redis://127.0.0.1:6379

# Email notifications (SMTP). Example uses Gmail app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HireHub <no-reply@hirehub.com>"
